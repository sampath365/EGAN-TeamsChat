# EGAN Pulse — server
PORT=4100
# Signing secret for session tokens. CHANGE THIS IN PRODUCTION.
AUTH_SECRET=dev-only-change-me
# Where the JSON store and uploads live (defaults to ./data)
DATA_DIR=
# Set to 1 to seed demo users/teams on first boot (default 1)
SEED_DEMO=1
# Comma separated origins allowed to call the API (default: same origin + localhost)
CORS_ORIGIN=

# Front-end (baked at build time)
VITE_API_PROXY_TARGET=http://localhost:4100
